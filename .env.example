# Copy this file to .env at the repository root for Docker Compose.
DB_HOST=db
DB_PORT=3306
DB_USER=briefly
DB_PASSWORD=replace-with-a-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
DB_NAME=briefly_news

# Generate a secret with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_IN=24h

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_SECRET=replace-with-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

NEWS_API_KEY=replace-with-your-newsapi-key
OLLAMA_URL=http://ollama:11434
PORT=3000
